# Copy to server/.env and fill in your own PostgreSQL details.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=access_control

PORT=3000

# Used to sign dashboard login tokens. Any long random string.
AUTH_SECRET=change-this-to-a-long-random-string

# =============================================================================
# SECURITY PASSWORDS
# =============================================================================
# Master security password required to unlock and confirm permanent employee deletion.
# You can change this to your own custom password anytime.
# (If your password contains special characters like '#', wrap it in double quotes)
# To allow multiple accepted passwords, separate them with commas (e.g. "pass1,pass2").
DELETE_PASSWORD="ADMIN@DELETE#2026"

# --- optional: pull data from the existing RFID-only system ----------------
LEGACY_SYNC_ENABLED=false
LEGACY_API_URL=http://192.168.1.50:8080/api/logs
LEGACY_API_TOKEN=
LEGACY_SYNC_INTERVAL_SEC=60
